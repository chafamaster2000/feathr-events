# Ports published on the host (local development only).
# Cambialos si ya tenes algo escuchando en esos puertos.
API_PORT=8000
MONGO_PORT=27017
ES_PORT=9200
REDIS_PORT=6379

# Elasticsearch JVM heap. 512m is plenty at this volume; without it ES takes half the
# machine's RAM.
ES_HEAP=512m

LOG_LEVEL=INFO

# Registers POST /demo/reset for the dashboard. Never enable in production.
DEMO_MODE=false
DASHBOARD_PORT=5173
