# Puertos publicados en el host (solo para desarrollo local).
# Cambialos si ya tenes algo escuchando en esos puertos.
API_PORT=8000
MONGO_PORT=27017
ES_PORT=9200
REDIS_PORT=6379

# Heap de la JVM de Elasticsearch. 512m alcanza de sobra para este volumen;
# sin esto ES se agarra la mitad de la RAM de la maquina.
ES_HEAP=512m

LOG_LEVEL=INFO
